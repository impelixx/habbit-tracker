# Server Configuration
PORT=8080
ENVIRONMENT=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=habbit

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_WEBHOOK_URL=https://your-app.railway.app/api/webhook/telegram

# JWT Configuration
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
JWT_EXPIRATION=168h  # 7 days

# OpenRouter Configuration (for AI features)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_LLM_MODEL=deepseek/deepseek-chat
OPENROUTER_LLM_FALLBACK=mistralai/mistral-7b-instruct

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://your-mini-app.vercel.app

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m

# Cache Configuration
CACHE_DEFAULT_TTL=5m
